// Prisma Schema for BrandBloom Multi-Tenant E-Commerce Platform
// Generator and datasource configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id                String              @id @default(cuid())
  name              String?
  email             String              @unique
  emailVerified     DateTime?
  image             String?
  password          String?             // Hashed password for credentials auth
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  // Relations
  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]        // Stores this user belongs to
  orderEvents       OrderEvent[]        // Order status changes made by user
  recommendations   Recommendation[]    // BloomPilot recommendations
  chatLogs          ChatLog[]           // Chatbot conversations

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// MULTI-TENANT STORE STRUCTURE
// ============================================================================

enum StoreStatus {
  DRAFT         // Store created but not published
  ACTIVE        // Store is live
  SUSPENDED     // Temporarily suspended
  ARCHIVED      // Archived/deleted
}

enum BusinessType {
  FASHION
  ELECTRONICS
  HOME_GARDEN
  BEAUTY_HEALTH
  SPORTS_OUTDOORS
  BOOKS_MEDIA
  FOOD_BEVERAGE
  TOYS_KIDS
  AUTOMOTIVE
  OTHER
}

model Store {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique     // For path-based URLs: /store/{slug}
  description     String?       @db.Text
  logo            String?                   // URL to logo image
  email           String?
  phone           String?
  address         String?       @db.Text
  businessType    BusinessType
  status          StoreStatus   @default(DRAFT)
  theme           String        @default("modern")  // Theme identifier
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?                 // When store went live

  // Relations
  memberships     Membership[]
  categories      Category[]
  products        Product[]
  customers       Customer[]
  orders          Order[]
  siteContent     SiteContent[]
  importJobs      ImportJob[]
  chatLogs        ChatLog[]
  recommendations Recommendation[]
  analytics       StoreAnalytics[]

  @@index([slug])
  @@index([status])
  @@map("stores")
}

// ============================================================================
// MEMBERSHIP & ROLES
// ============================================================================

enum MembershipRole {
  OWNER       // Full control
  STAFF       // Limited access (inventory, orders)
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Membership {
  id        String            @id @default(cuid())
  userId    String
  storeId   String
  role      MembershipRole
  status    MembershipStatus  @default(INVITED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@map("memberships")
}

// ============================================================================
// CATEGORIES & PRODUCTS
// ============================================================================

model Category {
  id          String    @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?   @db.Text
  isCustom    Boolean   @default(false)  // True if custom, false if predefined
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  storeId     String
  categoryId  String
  name        String
  slug        String
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)  // Original price for showing discounts
  cost        Decimal?  @db.Decimal(10, 2)  // Cost basis
  stock       Int       @default(0)
  sku         String?
  barcode     String?
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([storeId, isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String                         // e.g., "Size: Large, Color: Red"
  sku         String?
  price       Decimal? @db.Decimal(10, 2)   // Override product price
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ============================================================================
// CUSTOMERS & ORDERS
// ============================================================================

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, email])
  @@index([storeId])
  @@map("customers")
}

enum OrderStatus {
  PLACED
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                String      @id @default(cuid())
  storeId           String
  customerId        String
  orderNumber       String      @unique
  status            OrderStatus @default(PLACED)
  
  // Customer info snapshot
  customerName      String
  customerEmail     String
  customerPhone     String?
  
  // Shipping address
  shippingAddress   String      @db.Text
  shippingCity      String
  shippingState     String?
  shippingZip       String
  shippingCountry   String      @default("US")
  
  // Pricing
  subtotal          Decimal     @db.Decimal(10, 2)
  tax               Decimal     @db.Decimal(10, 2) @default(0)
  shipping          Decimal     @db.Decimal(10, 2) @default(0)
  discount          Decimal     @db.Decimal(10, 2) @default(0)
  total             Decimal     @db.Decimal(10, 2)
  
  notes             String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  completedAt       DateTime?

  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Customer     @relation(fields: [customerId], references: [id])
  items     OrderItem[]
  events    OrderEvent[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  
  // Product snapshot (preserve even if product deleted)
  productName     String
  productSku      String?
  variantName     String?
  price           Decimal @db.Decimal(10, 2)
  quantity        Int
  subtotal        Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  storeId   String
  userId    String?                     // Who made the change
  oldStatus OrderStatus?
  newStatus OrderStatus
  notes     String?     @db.Text
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([storeId])
  @@map("order_events")
}

// ============================================================================
// SITE CONTENT & CUSTOMIZATION
// ============================================================================

model SiteContent {
  id        String   @id @default(cuid())
  storeId   String
  key       String                      // e.g., "hero_banner", "footer_text"
  value     String   @db.Text          // Can be text or JSON
  type      String   @default("text")  // text, json, html, color, image
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@index([storeId])
  @@map("site_content")
}

// ============================================================================
// IMPORT SYSTEM
// ============================================================================

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ImportJob {
  id            String       @id @default(cuid())
  storeId       String
  fileName      String
  fileSize      Int
  totalRows     Int          @default(0)
  successRows   Int          @default(0)
  failedRows    Int          @default(0)
  status        ImportStatus @default(PENDING)
  errorReport   String?      @db.Text  // JSON array of errors
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
  @@map("import_jobs")
}

// ============================================================================
// AI CHATBOT & BLOOMPILOT
// ============================================================================

model ChatLog {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  question  String   @db.Text
  answer    String   @db.Text
  context   String?  @db.Text  // JSON with query details, data sources
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@map("chat_logs")
}

enum RecommendationType {
  PRODUCT_OPTIMIZATION    // Improve product details
  INVENTORY_ALERT         // Stock management
  PRICING_STRATEGY        // Pricing suggestions
  CONTENT_IMPROVEMENT     // Page/content updates
  MARKETING_OPPORTUNITY   // Promotion ideas
}

enum RecommendationStatus {
  PENDING      // Waiting for owner review
  APPROVED     // Owner approved
  REJECTED     // Owner rejected
  IMPLEMENTED  // Changes applied
  MEASURING    // Tracking results
}

model Recommendation {
  id              String                @id @default(cuid())
  storeId         String
  userId          String                // Who it was presented to
  type            RecommendationType
  status          RecommendationStatus  @default(PENDING)
  
  title           String
  description     String                @db.Text
  evidence        String                @db.Text  // JSON with supporting data
  proposedChange  String                @db.Text  // JSON with change details
  targetMetric    String?                         // What to measure
  
  // Measurement
  baselineValue   Decimal?              @db.Decimal(10, 2)
  baselineDate    DateTime?
  outcomeValue    Decimal?              @db.Decimal(10, 2)
  outcomeDate     DateTime?
  result          String?               @db.Text  // improved, worsened, inconclusive
  
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  approvedAt      DateTime?
  implementedAt   DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([status])
  @@index([type])
  @@map("recommendations")
}

// ============================================================================
// ANALYTICS
// ============================================================================

model StoreAnalytics {
  id           String   @id @default(cuid())
  storeId      String
  date         DateTime @db.Date
  
  // Traffic
  views        Int      @default(0)
  visitors     Int      @default(0)
  
  // Sales
  orders       Int      @default(0)
  revenue      Decimal  @db.Decimal(10, 2) @default(0)
  
  // Products
  productViews Int      @default(0)
  cartAdds     Int      @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([storeId])
  @@index([date])
  @@map("store_analytics")
}
